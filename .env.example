APP_ENV=development
RAG_API_KEY=change-this-secret

POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql://rag_user:change-this-database-password@postgres:5432/rag_db

AI_PROVIDER=openai

OPENAI_API_KEY=put-your-openai-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_OCR_MODEL=gpt-4o-mini

# USD prices per 1M tokens. Update these values if model pricing changes.
OPENAI_EMBEDDING_PRICE_PER_MILLION_TOKENS=0.02
OPENAI_CHAT_INPUT_PRICE_PER_MILLION_TOKENS=0.75
OPENAI_CHAT_CACHED_INPUT_PRICE_PER_MILLION_TOKENS=0.075
OPENAI_CHAT_OUTPUT_PRICE_PER_MILLION_TOKENS=4.50
OPENAI_OCR_INPUT_PRICE_PER_MILLION_TOKENS=0.15
OPENAI_OCR_CACHED_INPUT_PRICE_PER_MILLION_TOKENS=0.075
OPENAI_OCR_OUTPUT_PRICE_PER_MILLION_TOKENS=0.60

# Optional fallback provider
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite

UPLOAD_DIR=/code/app/uploads
TOP_K=5
EMBEDDING_DIM=768

# Contextual child chunks + page-level parent context.
# Existing PDFs must be retried/reindexed once after enabling this version.
MAX_CHUNK_TOKENS=900
CHUNK_OVERLAP_TOKENS=120
CONTEXTUAL_CHUNK_MAX_TOKENS=550
CONTEXTUAL_CHUNK_OVERLAP_TOKENS=80
PARENT_CONTEXT_MAX_TOKENS=1400
MAX_CHUNK_CHARS=7000
CHUNK_OVERLAP_CHARS=500
MAX_CHUNKS_PER_DOCUMENT=0
EMBEDDING_BATCH_SIZE=32
EMBEDDING_REQUEST_DELAY_SECONDS=0

# Upload validation and duplicate protection.
MAX_UPLOAD_SIZE_MB=100
ALLOW_DUPLICATE_DOCUMENTS=false

# High-recall database retrieval is cheap, so keep a broad candidate pool here.
RETRIEVAL_CANDIDATE_K=24
MIN_RELEVANCE_SCORE=0.20
VECTOR_WEIGHT=0.60
LEXICAL_WEIGHT=0.25
EXACT_MATCH_WEIGHT=0.15
NEIGHBOR_WINDOW=1
MAX_CONTEXT_CHUNKS=12

# Adaptive semantic reranking.
# Clear exact/lexical/high-margin winners skip the chat-model reranker entirely.
# Ambiguous searches use a smaller 8 x 800-character prompt instead of 14 x 1200.
SEMANTIC_RERANKER_ENABLED=true
SEMANTIC_RERANKER_ADAPTIVE_ENABLED=true
SEMANTIC_RERANKER_CANDIDATE_K=8
SEMANTIC_RERANKER_TOP_K=5
SEMANTIC_RERANKER_MAX_CHARS_PER_CANDIDATE=800
SEMANTIC_RERANKER_WEIGHT=0.78
SEMANTIC_RERANKER_SKIP_HYBRID_SCORE=0.68
SEMANTIC_RERANKER_SKIP_MARGIN=0.10
SEMANTIC_RERANKER_SKIP_EXACT_SCORE=0.72
SEMANTIC_RERANKER_SKIP_LEXICAL_SCORE=0.82
SEMANTIC_RERANKER_SKIP_LEXICAL_MIN_HYBRID=0.42

# Retrieval gate: accept strong evidence, retry one weak retrieval, otherwise abstain.
RETRIEVAL_GATE_ACCEPT_SCORE=0.60
RETRIEVAL_GATE_RETRY_SCORE=0.32
RETRIEVAL_GATE_MIN_HYBRID_SCORE=0.16
RETRIEVAL_GATE_MAX_RETRIES=1

# Automatic document routing. If the result is ambiguous, the API asks for the subject.
DOCUMENT_ROUTING_CANDIDATE_CHUNKS=80
DOCUMENT_ROUTING_MIN_SCORE=0.28
DOCUMENT_ROUTING_AMBIGUITY_MARGIN=0.08
DOCUMENT_ROUTING_MAX_DOCUMENTS=3
DOCUMENT_ROUTING_ACTIVE_BOOST=0.12

# Follow-up conversation memory and basic single-process rate limiting.
CONVERSATION_HISTORY_MESSAGES=6
RATE_LIMIT_REQUESTS_PER_MINUTE=120

ENABLE_OCR_FALLBACK=false
MAX_OCR_PAGES=10
OCR_RENDER_ZOOM=2.0
